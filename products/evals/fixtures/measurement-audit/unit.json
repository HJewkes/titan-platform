{
  "schema": "titan.unit/v1",
  "id": "measurement-audit",
  "version": "1.0.0",
  "title": "Audit a system's measurement",
  "description": "Propose the metrics a system should record and rank the capture gaps that block them. Scored by recall against a gold audit, plus cost.",
  "input": {
    "type": "object",
    "required": [
      "area"
    ],
    "properties": {
      "area": {
        "type": "string"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "metrics",
      "slices",
      "costUsd"
    ],
    "properties": {
      "metrics": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      },
      "slices": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "title",
            "metrics"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "costUsd": {
        "type": "number"
      }
    }
  },
  "objective": {
    "constraints": [
      {
        "metric": "metric-recall",
        "min": 0.8
      },
      {
        "metric": "cost_usd",
        "max": 5
      }
    ],
    "noCriticalFailures": true,
    "primary": {
      "name": "gap-recall",
      "direction": "maximize"
    }
  },
  "acceptance": {
    "levels": [
      {
        "level": 1,
        "minCases": 1
      },
      {
        "level": 2,
        "successLowerBound": 0.7
      }
    ]
  },
  "visibility": "public"
}
