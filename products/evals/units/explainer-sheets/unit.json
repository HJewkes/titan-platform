{
  "schema": "titan.unit/v1",
  "id": "explainer-sheets",
  "version": "1.0.0",
  "title": "Write the contact sheets, poster and video.json sidecar",
  "description": "Bridged until its TypeScript port lands; the variety lints arrive with PP-9 as reported checks, then gates.",
  "input": {
    "type": "object",
    "required": [
      "inputs"
    ],
    "properties": {
      "inputs": {
        "type": "object",
        "required": [
          "mp4",
          "script"
        ],
        "properties": {
          "mp4": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "script": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "outputs",
      "checks"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "sidecar",
          "poster"
        ],
        "properties": {
          "sidecar": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "poster": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "pass"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "pass": {
              "type": "boolean"
            },
            "gate": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "objective": {
    "constraints": [
      {
        "metric": "contract-failures",
        "max": 0
      }
    ],
    "noCriticalFailures": true,
    "primary": {
      "name": "wall_ms",
      "direction": "minimize"
    }
  },
  "acceptance": {
    "levels": [
      {
        "level": 1,
        "minCases": 8
      },
      {
        "level": 2,
        "successLowerBound": 0.7
      },
      {
        "level": 3,
        "successLowerBound": 0.85
      },
      {
        "level": 4,
        "holdDays": 14
      }
    ]
  },
  "visibility": "public"
}
