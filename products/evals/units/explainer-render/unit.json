{
  "schema": "titan.unit/v1",
  "id": "explainer-render",
  "version": "1.0.0",
  "title": "Render the timeline and audio to an MP4",
  "description": "Bridged until its TypeScript port lands; the host's render-gate check command is the cue gate inside render.",
  "input": {
    "type": "object",
    "required": [
      "inputs"
    ],
    "properties": {
      "inputs": {
        "type": "object",
        "required": [
          "words",
          "audio"
        ],
        "properties": {
          "words": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "audio": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "outputs",
      "checks"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "mp4",
          "vtt"
        ],
        "properties": {
          "mp4": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vtt": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "pass"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "pass": {
              "type": "boolean"
            },
            "gate": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "objective": {
    "constraints": [
      {
        "metric": "qa-held-errors",
        "max": 0
      }
    ],
    "noCriticalFailures": true,
    "primary": {
      "name": "wall_ms",
      "direction": "minimize"
    }
  },
  "acceptance": {
    "levels": [
      {
        "level": 1,
        "minCases": 8
      },
      {
        "level": 2,
        "successLowerBound": 0.7
      },
      {
        "level": 3,
        "successLowerBound": 0.85
      },
      {
        "level": 4,
        "holdDays": 14
      }
    ]
  },
  "visibility": "public"
}
