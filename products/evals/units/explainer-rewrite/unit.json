{
  "schema": "titan.unit/v1",
  "id": "explainer-rewrite",
  "version": "1.0.0",
  "title": "Rewrite a draft script's register",
  "description": "rewriteScript over the draft, per chapter per round; the checks step gates on any error-severity L0 row the rewrite turned red and reports the Q-V11 target rows.",
  "input": {
    "type": "object",
    "required": [
      "inputs"
    ],
    "properties": {
      "inputs": {
        "type": "object",
        "required": [
          "draft"
        ],
        "properties": {
          "draft": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "outputs",
      "checks"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "script",
          "rewrite-report"
        ],
        "properties": {
          "script": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rewrite-report": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "pass"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "pass": {
              "type": "boolean"
            },
            "gate": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "objective": {
    "constraints": [
      {
        "metric": "new-l0-error-rows",
        "max": 0
      }
    ],
    "noCriticalFailures": true,
    "primary": {
      "name": "rewrite-rows-red",
      "direction": "minimize"
    }
  },
  "acceptance": {
    "levels": [
      {
        "level": 1,
        "minCases": 10
      },
      {
        "level": 2,
        "successLowerBound": 0.7
      },
      {
        "level": 3,
        "successLowerBound": 0.85
      },
      {
        "level": 4,
        "holdDays": 14
      }
    ]
  },
  "visibility": "public"
}
