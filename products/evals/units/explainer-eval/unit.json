{
  "schema": "titan.unit/v1",
  "id": "explainer-eval",
  "version": "1.0.0",
  "title": "Check the final script and record the cold-viewer rubric",
  "description": "L0 with the spine lints and pace on the final script as gates, then the reported-only cold-viewer rubric (J8 to J12).",
  "input": {
    "type": "object",
    "required": [
      "inputs"
    ],
    "properties": {
      "inputs": {
        "type": "object",
        "required": [
          "script",
          "spine"
        ],
        "properties": {
          "script": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "spine": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "outputs",
      "checks"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "l0"
        ],
        "properties": {
          "l0": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "pass"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "pass": {
              "type": "boolean"
            },
            "gate": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "objective": {
    "constraints": [
      {
        "metric": "l0-error-rows",
        "max": 0
      }
    ],
    "noCriticalFailures": true,
    "primary": {
      "name": "cold-undefined-items-per-min",
      "direction": "minimize"
    }
  },
  "acceptance": {
    "levels": [
      {
        "level": 1,
        "minCases": 3
      },
      {
        "level": 2,
        "successLowerBound": 0.7
      },
      {
        "level": 3,
        "successLowerBound": 0.85
      },
      {
        "level": 4,
        "holdDays": 14
      }
    ]
  },
  "visibility": "public"
}
