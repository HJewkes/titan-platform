{
  "name": "@titan-design/explainer",
  "version": "0.2.1",
  "description": "Explainer video pipeline: beats.json and digest.json schemas, packet builder, finding attribution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "doctrine",
    "stage-bumps",
    "rubrics",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "products/explainer"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "build:page": "vite build -c src/composition/vite.config.ts",
    "page:sheet": "esbuild src/composition/parity-sheet-cli.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist/sheet/page-sheet.mjs && node dist/sheet/page-sheet.mjs",
    "page:pairs": "esbuild src/composition/pair-sheet-cli.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist/sheet/page-pairs.mjs && node dist/sheet/page-pairs.mjs",
    "render:smoke": "esbuild src/render/render-smoke-cli.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist/render-smoke.mjs && node dist/render-smoke.mjs"
  },
  "dependencies": {
    "@titan-design/agent": "workspace:^",
    "@titan-design/agent-dispatch": "workspace:^",
    "@titan-design/agent-protocol": "workspace:^",
    "@titan-design/app-paths": "workspace:^",
    "@titan-design/code-graph": "workspace:^",
    "@titan-design/code-read": "workspace:^",
    "@titan-design/evidence": "workspace:^",
    "@titan-design/frame-capture": "workspace:^",
    "@titan-design/github": "workspace:^",
    "@titan-design/graph-layout": "workspace:^",
    "@titan-design/hitl": "workspace:^",
    "@titan-design/owner-queue": "workspace:^",
    "@titan-design/pm": "workspace:^",
    "@titan-design/react-ui": "^0.23.1",
    "@titan-design/render-qa": "workspace:^",
    "@titan-design/rpc-protocol": "workspace:^",
    "@titan-design/session-read": "workspace:^",
    "@titan-design/speech-g2p": "workspace:^",
    "@titan-design/speech-stt": "workspace:^",
    "@titan-design/speech-tts": "workspace:^",
    "@titan-design/speech-vet": "workspace:^",
    "@titan-design/store-sqlite": "workspace:^",
    "@titan-design/workflow": "workspace:^",
    "commander": "^14.0.3",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.0",
    "vite": "^8.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@titan-design/test-kit": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17"
  },
  "bin": {
    "explainer": "./dist/bin.js"
  }
}
