# Reference only: ./scripts/setup.sh appends every missing key to .env and generates the secrets.
# Set SERVER_NAME (and PUBLIC_BASE_URL for the remote profile) before the first setup.sh; the name is fixed once data/db exists.
SERVER_NAME=tp301.local
# PUBLIC_BASE_URL=https://chat.example.org
HS_URL=http://localhost:8008
CORE_URL=http://core:9009
CORE_PORT=9009
# Generated by setup.sh with `openssl rand -hex 32`; never commit real values.
CORE_AS_TOKEN=
CORE_HS_TOKEN=
EDGE1_AS_TOKEN=
EDGE1_HS_TOKEN=
REG_SHARED_SECRET=
OWNER_PASSWORD=
