{
  "$comment": "Architectural fitness rules for titan-platform, run by codewatch's `graph check` (scripts/dag-check.sh). The package-layers rule IS the platform DAG: a package may import only packages in the same tier or a lower one. `$tiers` is the source of truth (edited by scripts/new-package.mjs); `layers` is derived from it by dropping empty tiers, because codewatch rejects empty layers.",
  "rules": [
    {
      "id": "package-layers",
      "type": "layered-deps",
      "$tiers": {
        "0": [
          "packages/store-sqlite",
          "packages/locator",
          "packages/cluster",
          "packages/embed",
          "packages/agent-protocol",
          "packages/chat-protocol",
          "packages/code-parser",
          "packages/rpc-protocol"
        ],
        "1": [
          "packages/retrieval",
          "packages/agent",
          "packages/registry",
          "packages/daemon",
          "packages/hitl",
          "packages/agent-lifecycle",
          "packages/messaging",
          "packages/rpc-client",
          "packages/matrix-bus"
        ],
        "2": [
          "packages/session-read",
          "packages/session-graph",
          "packages/code-graph",
          "packages/workflow",
          "packages/memory",
          "packages/style-profile",
          "packages/style-analyzer",
          "packages/style-checker",
          "packages/code-read",
          "packages/session-analytics",
          "packages/queue-mirror"
        ],
        "ui": [
          "packages/react-app"
        ],
        "product": [
          "products/session-miner",
          "products/retrieval-eval",
          "apps/code-report"
        ]
      },
      "layers": [
        [
          "packages/store-sqlite",
          "packages/locator",
          "packages/cluster",
          "packages/embed",
          "packages/agent-protocol",
          "packages/chat-protocol",
          "packages/code-parser",
          "packages/rpc-protocol"
        ],
        [
          "packages/retrieval",
          "packages/agent",
          "packages/registry",
          "packages/daemon",
          "packages/hitl",
          "packages/agent-lifecycle",
          "packages/messaging",
          "packages/rpc-client",
          "packages/matrix-bus"
        ],
        [
          "packages/session-read",
          "packages/session-graph",
          "packages/code-graph",
          "packages/workflow",
          "packages/memory",
          "packages/style-profile",
          "packages/style-analyzer",
          "packages/style-checker",
          "packages/code-read",
          "packages/session-analytics",
          "packages/queue-mirror"
        ],
        [
          "packages/react-app"
        ],
        [
          "products/session-miner",
          "products/retrieval-eval",
          "apps/code-report"
        ]
      ]
    },
    {
      "id": "code-graph-history-seam",
      "type": "layered-deps",
      "$comment": "packages/code-graph/src/history imports nothing from the rest of code-graph, so a later extraction into @titan-design/git-history is a directory move. The rest of code-graph may import history.",
      "layers": [
        [
          "packages/code-graph/src/history"
        ],
        [
          "packages/code-graph/src"
        ]
      ]
    },
    {
      "id": "code-graph-catalogue-pure",
      "type": "layered-deps",
      "$comment": "The metric catalogue imports only its own directory and types.ts, so a browser-safe subpath can re-export it without pulling in ts-morph, tree-sitter, or SQLite.",
      "layers": [
        [
          "packages/code-graph/src/catalogue",
          "packages/code-graph/src/types.ts"
        ],
        [
          "packages/code-graph/src"
        ]
      ]
    },
    {
      "id": "code-graph-catalogue-no-node",
      "type": "forbid-import",
      "$comment": "Node builtins would break the catalogue in a browser.",
      "from": "packages/code-graph/src/catalogue/**",
      "to": "node:**"
    },
    {
      "id": "rpc-client-browser-no-node",
      "type": "forbid-import",
      "$comment": "rpc-client's main entry ships to browsers; only src/node (exportSnapshot) may use Node builtins.",
      "from": "packages/rpc-client/src/client/**",
      "to": "node:**"
    },
    {
      "id": "react-app-browser-no-node",
      "type": "forbid-import",
      "$comment": "react-app's main entry ships to browsers; only src/vite (the build preset) may use Node builtins.",
      "from": "packages/react-app/src/hooks/**",
      "to": "node:**"
    },
    {
      "id": "react-app-browser-no-vite",
      "type": "forbid-import",
      "$comment": "Vite is an optional peer for the ./vite entry; the hooks must load without it. The leading ** anchors the match so npm:vitest in tests stays allowed.",
      "from": "packages/react-app/src/hooks/**",
      "to": "**npm:vite"
    },
    {
      "id": "no-titan-design-library-imports",
      "type": "forbid-import",
      "$comment": "Libraries never import across the repo line: titan-design may use titan-platform packages, not the reverse. Only products and apps may import @titan-design/react-ui.",
      "from": "packages/**",
      "to": "npm:@titan-design/react-ui"
    },
    {
      "id": "code-report-browser-no-node",
      "type": "forbid-import",
      "$comment": "apps/code-report/src ships to the browser, including as a file opened from disk; only server/ may use Node builtins.",
      "from": "apps/code-report/src/**",
      "to": "node:**"
    },
    {
      "id": "code-report-browser-no-code-graph",
      "type": "forbid-import",
      "$comment": "code-graph's root pulls in ts-morph, tree-sitter, and SQLite; the browser reads code-read's ./query and the exported dataset instead.",
      "from": "apps/code-report/src/**",
      "to": "packages/code-graph/**"
    },
    {
      "id": "code-read-query-pure",
      "type": "layered-deps",
      "$comment": "code-read's ./query subpath imports only its own directory, so the browser bundle never reaches the SQLite loader or the registry wiring.",
      "layers": [
        [
          "packages/code-read/src/query"
        ],
        [
          "packages/code-read/src"
        ]
      ]
    },
    {
      "id": "code-read-query-no-node",
      "type": "forbid-import",
      "$comment": "Node builtins would break ./query in a browser.",
      "from": "packages/code-read/src/query/**",
      "to": "node:**"
    },
    {
      "id": "code-read-query-no-code-graph",
      "type": "forbid-import",
      "$comment": "code-graph's root pulls in ts-morph, tree-sitter, and SQLite; ./query receives the catalogue through buildReadModel instead.",
      "from": "packages/code-read/src/query/**",
      "to": "packages/code-graph/**"
    },
    {
      "id": "max-file-loc",
      "type": "metric-max",
      "metric": "loc",
      "kind": "file",
      "max": 350,
      "excludeRoles": [
        "test",
        "fixture"
      ]
    },
    {
      "id": "max-cyclomatic-per-function",
      "type": "metric-max",
      "metric": "cyclomatic_max",
      "kind": "file",
      "max": 30,
      "excludeRoles": [
        "test",
        "fixture"
      ]
    },
    {
      "id": "max-nesting-depth",
      "type": "metric-max",
      "metric": "max_nesting_depth",
      "kind": "file",
      "max": 5,
      "excludeRoles": [
        "test",
        "fixture"
      ]
    }
  ]
}
