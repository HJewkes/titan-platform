# Dispatcher shadow tick: writes shadow rows and dispatches nothing. Inert unless the rule file sets shadow.enabled: true (TP-5766).
# Install steps: products/factory/README.md, "Dispatcher shadow".
[Unit]
Description=Titan factory: dispatcher shadow tick
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
# Sets ACTIVE_ROOT and TITAN_FACTORY_DB; the same file the owner-gates unit reads.
EnvironmentFile=%h/.config/titan-factory/owner-gates.env
# No path or flag: the tick reads its rule file from the default place.
ExecStart=/usr/bin/node %h/.local/share/titan-factory/deploy/titan-platform/products/factory/dist/bin.js dispatch shadow-tick
# 75 is "another run holds the lock": nothing happened and the next tick retries.
SuccessExitStatus=75
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle
