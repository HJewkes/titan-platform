{
  "name": "titan-console",
  "version": "0.13.0",
  "private": true,
  "description": "The titan console: one read-only loopback daemon and react-ui shell over active-work, the agent-chat broker and the session graph",
  "type": "module",
  "license": "MIT",
  "author": "Henry Jewkes",
  "bin": {
    "titan-console": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "vite build && tsup && tsx server/stamp-build.ts",
    "serve": "tsx server/cli.ts",
    "export": "tsx server/export.ts",
    "capture": "vite build && tsx server/twin/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@titan-design/agent": "workspace:^",
    "@titan-design/agent-dispatch": "workspace:^",
    "@titan-design/app-paths": "workspace:*",
    "@titan-design/chat-protocol": "workspace:^",
    "@titan-design/coordinator": "workspace:^",
    "@titan-design/daemon": "workspace:^",
    "@titan-design/decider": "workspace:^",
    "@titan-design/fix-proof": "workspace:^",
    "@titan-design/github": "workspace:^",
    "@titan-design/owner-queue": "workspace:^",
    "@titan-design/pm": "workspace:^",
    "@titan-design/png-delta": "workspace:^",
    "@titan-design/react-app": "workspace:*",
    "@titan-design/react-ui": "^0.23.1",
    "@titan-design/registry": "workspace:^",
    "@titan-design/review-schema": "^0.1.0",
    "@titan-design/rpc-client": "workspace:*",
    "@titan-design/session-analytics": "workspace:^",
    "@titan-design/session-graph": "workspace:^",
    "@titan-design/session-read": "workspace:^",
    "@titan-design/store-sqlite": "workspace:^",
    "@titan-design/worktree": "workspace:^",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@titan-design/egress-scan": "workspace:^",
    "@titan-design/evidence": "workspace:^",
    "@titan-design/frame-capture": "workspace:^",
    "@titan-design/test-kit": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.0",
    "nativewind": "^4.2.1",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "vite": "^8.0.3"
  }
}
