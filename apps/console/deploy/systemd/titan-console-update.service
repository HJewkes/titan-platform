# Rebuilds and swaps in the served console when a console change lands on main (TP-2258).
# Installed by the owner; see apps/console/docs/self-update.md.
[Unit]
Description=titan-console self-update
After=network-online.target

[Service]
Type=oneshot
# The updater runs from the release that is serving; it keeps that release when it prunes.
ExecStart=/usr/bin/env node %h/.local/share/titan-console/current/apps/console/dist/cli.js self-update
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Exit 75 is a run that found another holding the lock, not a failure.
SuccessExitStatus=75
TimeoutStartSec=30min
Nice=10
UMask=0077
