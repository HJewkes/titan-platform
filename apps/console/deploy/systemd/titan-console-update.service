# Builds origin/main and hands off to that build's own updater when main moves (TP-2258, TP-4043).
# Installed by the owner; see apps/console/docs/self-update.md.
[Unit]
Description=titan-console self-update
After=network-online.target

[Service]
Type=oneshot
# The bootstrap is a copy outside every release, so no release's bug can stop the update that fixes it.
ExecStart=/usr/bin/env node %h/.local/share/titan-console/bin/titan-console-bootstrap.mts
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Exit 75 is a run that found another holding the lock, not a failure.
SuccessExitStatus=75
TimeoutStartSec=30min
Nice=10
UMask=0077
