{
  "name": "titan-platform",
  "private": true,
  "type": "module",
  "description": "Reusable @titan-design/* packages (a strict acyclic DAG) and the products composed from them",
  "license": "MIT",
  "author": "Henry Jewkes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint scripts eslint.config.js vitest.config.ts && pnpm -r run lint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --exclude '**/*.repo.test.ts'",
    "dag:check": "node scripts/dag-check-self.mjs",
    "dead:check": "node --max-old-space-size=1024 scripts/dead-code-check.mjs",
    "new:package": "node scripts/new-package.mjs",
    "docs:reference": "node scripts/gen-docs-reference.mjs",
    "capabilities": "node scripts/gen-capabilities.mjs",
    "capabilities:check": "node scripts/gen-capabilities.mjs --check",
    "egress:scan": "node packages/egress-scan/dist/bin.js",
    "docs:dev": "pnpm docs:reference && vitepress dev site",
    "docs:build": "pnpm docs:reference && vitepress build site",
    "docs:preview": "vitepress preview site",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/gen-capabilities.mjs",
    "release": "pnpm -r run build && changeset publish",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "factory:install": "pnpm install && pnpm --filter \"@titan-design/factory...\" build && node scripts/factory-build-helper.mjs && node scripts/factory-link-bin.mjs",
    "prepare": "pnpm --silent --filter @titan-design/egress-scan run build && node packages/egress-scan/dist/bin.js install-hook || echo \"egress-scan: pre-push hook not installed; run pnpm build, then pnpm run prepare\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.39.0",
    "@titan-design/egress-scan": "workspace:*",
    "@types/node": "^25.3.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "mermaid": "^11.17.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.0.0"
  }
}
