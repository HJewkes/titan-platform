{
  "name": "@titan-design/queue-mirror",
  "version": "0.2.0",
  "description": "Projects a local queue of human-actionable items into a Matrix room and folds the owner's verdicts back",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hitl": {
      "types": "./dist/hitl.d.ts",
      "import": "./dist/hitl.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/queue-mirror"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@titan-design/hitl": "workspace:^",
    "@titan-design/matrix-bus": "workspace:^",
    "@titan-design/store-sqlite": "workspace:^"
  }
}
