{
  "name": "@titan-design/style-analyzer",
  "version": "0.0.0",
  "description": "Tree-sitter style extractors that turn source files into observations, and the aggregator that turns observations into a style profile with confidence and stability",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/style-analyzer"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@jscpd/core": "3.5.10",
    "@jscpd/tokenizer": "3.5.4",
    "@titan-design/code-parser": "workspace:^",
    "@titan-design/style-profile": "workspace:^"
  },
  "peerDependencies": {
    "web-tree-sitter": "^0.26.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "web-tree-sitter": "^0.26.6",
    "zod": "^4.4.3"
  }
}
