  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "NOTICE"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/speech-g2p"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@titan-design/rpc-protocol": "workspace:^",
    "compromise": "14.18.0"
  }
