{
  "name": "@titan-design/eslint-plugin",
  "version": "0.0.0",
  "description": "ESLint rules that enforce the titan code-quality limits: functions of at most 30 non-blank lines, comments that hold code, and TODO comments without a tracking task",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "eslint": "^9.39.0"
  }
}
