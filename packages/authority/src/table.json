    {
      "id": "MRG-OT",
      "action": "merge",
      "actor": "owner-terminal",
      "verdict": "allow",
      "evidence": [
        "E-gh"
      ]
    },
    {
      "id": "MRG-OR",
      "action": "merge",
      "actor": "owner-remote",
      "verdict": "gate",
      "resolvers": [
        "owner-remote"
      ],
      "condition": "Read-back of repo, pull request number, head SHA and title. Resolves a coordinator or automation merge gate; no direct door.",
      "evidence": [
        "E-gate",
        "E-prin"
      ]
    },
    {
      "id": "MRG-CO",
      "action": "merge",
      "actor": "coordinator",
      "verdict": "gate",
      "resolvers": [
        "owner-terminal",
        "owner-remote"
      ],
      "evidence": [
        "E-gate",
        "E-dec"
      ]
    },
    {
      "id": "MRG-WK",
      "action": "merge",
      "actor": "worker",
      "verdict": "deny",
      "evidence": [
        "E-ref"
      ]
    },
    {
      "id": "MRG-HD",
      "action": "merge",
      "actor": "headless",
      "verdict": "deny",
      "evidence": [
        "E-ref"
      ]
    },
    {
      "id": "MRG-AU",
      "action": "merge",
      "actor": "automation",
      "verdict": "gate",
      "resolvers": [
        "owner-terminal",
        "owner-remote"
      ],
      "condition": "Merge on green plus owner approval.",
      "evidence": [
        "E-gate",
        "E-gh"
      ]
    },
    {
      "id": "MRG-AU-RV",
      "action": "merge",
      "actor": "automation",
      "verdict": "allow",
      "condition": "Owner decision D-A, all seats: the run-dispatched reviewer's MERGE verdict at the exact head, with required check runs green from the allowed apps, stands in for the owner's tap. A trusted collector, never the requester, observes the facts; its changed paths include both sides of every rename. A tainted request never matches. Otherwise MRG-AU gates.",
      "when": [
        "resolver-is-dispatched-reviewer",
        "verdict-merge-at-head",
        "required-contexts-green",
        "no-non-green-run",
        "merge-tree-clean",
        "repo-not-frozen",
        "no-protected-path-change",
        "seat-grants-merge-on-green-approve"
      ],
      "evidence": [
        "E-gate",
        "E-gh",
        "E-rev"
      ]
    },
    {
      "id": "MRG-AU-RC",
      "action": "merge",
      "actor": "automation",
      "verdict": "allow",
      "condition": "Owner decision of 2026-09-29 extended to automation: a head produced by update-branch inherits the run-dispatched reviewer's MERGE when its tree equals the merge-tree of the reviewed head onto main, attested by the factory's carry probe, never by the reviewer. Every other MRG-AU-RV condition still holds at the new head. A separate row, so deleting it revokes carrying. No kind fact exists yet, so a security-kind pull request is not excluded here.",
      "when": [
        "resolver-is-dispatched-reviewer",
        "verdict-merge-carried-tree-equal",
        "required-contexts-green",
        "no-non-green-run",
        "merge-tree-clean",
        "repo-not-frozen",
        "no-protected-path-change",
        "seat-grants-merge-on-green-approve"
      ],
      "evidence": [
        "E-gate",
        "E-gh",
        "E-rev"
      ]
    },
