[Unit]
Description=Record that %i failed

[Service]
Type=oneshot
# An error-priority journal line (journalctl --user -p err), and a marker file whose
# presence and mtime say the poller is failing; the poll service removes it on success.
ExecStart=logger --priority user.err --tag anthropic-account "%i failed; see journalctl --user -u %i"
ExecStart=touch %S/anthropic-account/%i.failed
StateDirectory=anthropic-account
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
