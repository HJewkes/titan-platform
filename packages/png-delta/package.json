    "directory": "packages/png-delta"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
