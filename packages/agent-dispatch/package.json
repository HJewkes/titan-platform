{
  "name": "@titan-design/agent-dispatch",
  "version": "0.10.0",
  "description": "Start and resume agent-chat agents through the agent-chat CLI, with the brief kept out of argv",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./limits": {
      "types": "./dist/limits/index.d.ts",
      "import": "./dist/limits/index.js"
    },
    "./limits/node": {
      "types": "./dist/limits/node.d.ts",
      "import": "./dist/limits/node.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js"
    },
    "./routing/node": {
      "types": "./dist/routing/node.d.ts",
      "import": "./dist/routing/node.js"
    },
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "import": "./dist/profiles/index.js"
    },
    "./profiles/node": {
      "types": "./dist/profiles/node.d.ts",
      "import": "./dist/profiles/node.js"
    },
    "./launch": {
      "types": "./dist/launch/index.d.ts",
      "import": "./dist/launch/index.js"
    },
    "./brief": {
      "types": "./dist/brief/index.d.ts",
      "import": "./dist/brief/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./roster": {
      "types": "./dist/roster/index.d.ts",
      "import": "./dist/roster/index.js"
    },
    "./gates": {
      "types": "./dist/gates/index.d.ts",
      "import": "./dist/gates/index.js"
    },
    "./isolation": {
      "types": "./dist/isolation/index.d.ts",
      "import": "./dist/isolation/index.js"
    }
  },
  "files": [
    "dist",
    "workflow",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/agent-dispatch"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@titan-design/rpc-protocol": "workspace:^",
    "@titan-design/store-sqlite": "workspace:^",
    "@titan-design/worktree": "workspace:^",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  }
}
