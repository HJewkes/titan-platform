{
  "name": "@titan-design/fix-proof",
  "version": "0.8.0",
  "description": "Proves a fix PR's new tests fail on the merge base and pass at head: diff plan, vitest report classification, fix-proof/v1 result line",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "fix-proof": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./linear-regexp": {
      "types": "./dist/linear-regexp.d.ts",
      "import": "./dist/linear-regexp.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/fix-proof"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@titan-design/rpc-protocol": "workspace:^"
  },
  "devDependencies": {
    "@titan-design/test-kit": "workspace:*"
  }
}
