{
  "name": "@titan-design/speech-tts",
  "version": "0.1.1",
  "description": "Swappable text-to-speech provider contract, registry and command/HTTP adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/speech-tts"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@titan-design/app-paths": "workspace:^",
    "@titan-design/rpc-protocol": "workspace:^"
  },
  "devDependencies": {
    "@titan-design/speech-g2p": "workspace:*",
    "@titan-design/speech-stt": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "kokoro-js": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "smoke:speech": "node scripts/smoke-speech.ts"
  }
}
