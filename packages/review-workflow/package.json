    "directory": "packages/review-workflow"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@titan-design/agent-dispatch": "workspace:^",
    "@titan-design/evidence": "workspace:^",
    "@titan-design/fix-proof": "workspace:^",
    "@titan-design/github": "workspace:^",
    "@titan-design/review-panel": "workspace:^",
    "@titan-design/workflow": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@titan-design/hitl": "workspace:*",
    "@titan-design/store-sqlite": "workspace:*",
    "@titan-design/test-kit": "workspace:*",
    "zod": "^4.4.3"
  }
