{
  "name": "@titan-design/rpc-client",
  "version": "0.0.0",
  "description": "Browser-safe typed client for titan daemons, with live (HTTP + SSE) and static (snapshot file) data sources",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/rpc-client"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@titan-design/rpc-protocol": "workspace:*"
  },
  "devDependencies": {
    "@titan-design/daemon": "workspace:*",
    "@titan-design/registry": "workspace:*",
    "zod": "^4.4.3"
  }
}
