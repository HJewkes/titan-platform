{
  "name": "@titan-design/code-parser",
  "version": "0.2.0",
  "description": "Tree-sitter WASM parsing for TypeScript, TSX and Python, plus the source-file filter and the Extractor contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-kinds": {
      "types": "./dist/node-kinds.d.ts",
      "import": "./dist/node-kinds.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/titan-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/titan-platform.git",
    "directory": "packages/code-parser"
  },
  "bugs": "https://github.com/HJewkes/titan-platform/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "peerDependencies": {
    "web-tree-sitter": "^0.26.6"
  },
  "devDependencies": {
    "web-tree-sitter": "^0.26.6"
  }
}
