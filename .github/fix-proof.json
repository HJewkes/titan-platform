{
  "tests": [
    "{packages,products,apps}/*/src/**/*.test.{ts,tsx}",
    "apps/*/{scripts,server}/**/*.test.ts",
    "products/active-work/__tests__/**/*.test.ts",
    "scripts/**/*.test.mjs"
  ],
  "carry": [
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/test-support/**",
    "**/testdata/**",
    "**/*.test-helpers.ts",
    "**/*.fixture.ts",
    "products/active-work/__tests__/**",
    "**/eslint-suppressions*.json"
  ],
  "runtime": [
    "packages/agent-protocol/fixtures/**",
    "apps/console/fixtures/**",
    ".codewatch/**",
    ".github/**"
  ],
  "build": "pnpm build"
}
